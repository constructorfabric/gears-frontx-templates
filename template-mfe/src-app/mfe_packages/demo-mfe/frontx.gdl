# This micro-frontend's passport: everything a tool that assembles a product
# from FrontX packages (Gearbox, Constructor Studio) needs to know about it, in
# one file. It restates what package.json and mfe.json say, and those tools
# check that they agree, so keep them in step when either changes. See
# "Package passports: frontx.gdl" in the repository README.
gdl_version = "1.5"

mfe(
    # Who it is: package.json's name and version (it has no description).
    name = "@gears-frontx/demo-mfe",
    version = "0.2.0-alpha.0",

    # The backend gears its screens call, by gear id. None: its accounts API
    # (`/api/accounts`) is mocked, not a gear's.
    requires = [],

    # What it brings, as mfe.json says: the labels of its screens, then the
    # route of each extension, in mfe.json's order.
    screens = ["Widgets Host", "Hello World", "Profile", "Current Theme", "UIKit Elements"],
    mounts = ["/widgets-host", "/hello-world", "/profile", "/current-theme", "/uikit-elements"],

    # The FrontX it is written against: its @gears-frontx/react pin. A shell
    # mounting it gives it the shell's own version, whatever this says.
    frontx = "0.2.0-alpha.15",

    # The permissions its screens need: none, it calls no gear.
    roles = [],

    # Routes worth a screenshot.
    preview = ["/hello-world", "/profile", "/uikit-elements"],
    # Mock data its screens render with, for screenshots without a backend.
    fixtures = "src/api/mocks.ts",
)
