{
  "name": "@gears-frontx/widgets-fixture-b",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "description": "Leaf widget MFE. Targets the widgets domain (owned by demo-mfe's child FrontX app at runtime) via its Extension instance. Mounts concurrently alongside widgets-fixture-a under ConcurrentMountStrategy.",
  "scripts": {
    "dev": "vite build && vite preview --port 3202",
    "build": "vite build",
    "cache:clear": "node -e \"require('node:fs').rmSync('node_modules/.cache/frontx-unit-producer',{recursive:true,force:true})\"",
    "build:clean": "npm run cache:clear && vite build",
    "type-check": "tsc --noEmit",
    "preview": "vite preview --port 3202",
    "test": "npm run test:unit",
    "test:unit": "vitest --run --passWithNoTests=false",
    "test:unit:watch": "vitest --watch"
  },
  "dependencies": {
    "@gears-frontx/react": "0.2.0-alpha.19",
    "@tanstack/react-query": "5.101.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@gears-frontx/api": "0.3.2",
    "@gears-frontx/framework": "0.2.0-alpha.21",
    "@gears-frontx/gts-plugin": "0.7.1",
    "@gears-frontx/i18n": "0.2.0-alpha.2",
    "@gears-frontx/mfes": "0.7.1",
    "@gears-frontx/routing": "0.4.1",
    "@gears-frontx/state": "0.2.0-alpha.4",
    "@gears-frontx/vite-plugin-mfe-gts": "0.1.0-alpha.2",
    "@module-federation/vite": "1.20.5",
    "@reduxjs/toolkit": "2.12.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "26.1.0",
    "react-redux": "^9.2.0",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "4.1.4"
  }
}
