                "CardHeader",
                "CardTitle",
                "CardContent",
                "ChartContainer",
                "ChartTooltip",
                "ChartTooltipContent",
                "ChartLegend",
                "ChartLegendContent"
              ],
              "note": "Recharts BarChart laid out vertically, one bar per lead source split won and lost; the headline percent is computed, not stored."
            }
          ]
        },
        {
          "pane": "recent activity",
          "module": "src/screens/dashboard/ActivityTable.tsx",
          "parts": [
            {
              "part": "table",
              "kit": [
                "DataTable",
                "dataTableColumnHelper",
                "DataTableSortButton",
                "Avatar",
                "AvatarFallback",
                "Badge",
                "Input",
                "lucide-react: ContactIcon, TagIcon, CircleDotIcon, UserRoundIcon, CalendarDaysIcon, SearchIcon"
              ],
              "note": "Full width, no secondary sidebar above it; sorting and pagination come from DataTable. Each column header carries its lucide icon, and the header shows a live row count and a search Input rendered disabled. The contact cell is an Avatar with the contact's initials, name and company, read from the inbox dataset's contacts by id, and the agent a row belongs to is named by its TopAgent id - no second set of people."
            }
          ]
        }
      ],
      "route": "#/dashboard"
