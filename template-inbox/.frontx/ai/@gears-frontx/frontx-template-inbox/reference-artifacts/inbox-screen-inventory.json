{
  "id": "inbox-screen-inventory",
  "version": "3.0.0",
  "description": "Each pane of the four shipped screens, and the @gears-frontx/ui-kit component that renders each of its parts. A screen added to this app composes from the same vocabulary; anything not listed here is either a plain element carrying a class from the app's own stylesheets, or a component that has not been needed yet.",
  "app": {
    "entry": "src/main.tsx",
    "root": "src/app/App.tsx",
    "stylesheet": "src/styles/workspace.module.css",
    "screenStylesheets": [
      "src/styles/dashboard.module.css",
      "src/styles/mail.module.css"
    ]
  },
  "chrome": [
    {
      "part": "icon rail",
      "module": "src/app/IconRail.tsx",
      "kit": [
        "Button",
        "Popover",
        "PopoverTrigger",
        "PopoverContent",
        "Separator",
        "ItemGroup",
        "Item",
        "ItemMedia",
        "ItemContent",
        "ItemTitle",
        "lucide-react: LayoutDashboardIcon, BlocksIcon, MessageCircleIcon, MailIcon, UsersIcon, SunIcon, MoonIcon, UserIcon, SettingsIcon, LogOutIcon"
      ],
      "note": "Fixed 4rem, never collapsed. Mark at the top, one Button per section with variant=\"secondary\" and aria-current=\"page\" when active - Dashboard first, then Chat, Mail, Contacts - flexible spacer, then the theme toggle and the profile-menu Popover, whose Profile, Settings and Log out items are inert. Popups need no container - they portal to the app's own body."
    },
    {
      "part": "routing",
      "module": "src/app/routing.ts",
      "kit": [],
      "note": "Hash routes: #/dashboard (DASHBOARD_ROUTE), #/chat (INBOX_ROUTE), #/mail (MAIL_ROUTE), #/contacts (CONTACTS_ROUTE), #/contacts/{id} (contactRoute(id)). parseRoute sends anything unrecognised to the dashboard, #/inbox to the chat screen and an undecodable contact id to the directory; useRoute rewrites the address bar to the canonical fragment without a history entry."
    },
    {
      "part": "theme",
      "module": "src/app/theme.ts",
      "kit": [],
      "note": "No data-theme until the visitor toggles, so the kit's theme.css follows prefers-color-scheme; the toggle sets data-theme on the document root and stores the choice in localStorage, and applyStoredTheme restores it before the first render."
    },
    {
      "part": "error boundary",
      "module": "src/app/ErrorBoundary.tsx",
      "kit": [
        "Alert",
        "AlertTitle",
        "AlertDescription",
        "AlertAction",
        "Button",
        "lucide-react: CircleAlertIcon"
      ],
      "note": "Wraps App in src/main.tsx; a render error replaces the app with a destructive Alert and a reload button."
    }
  ],
  "sharedParts": [
    {
      "part": "presence avatar",
      "module": "src/shared/PresenceAvatar.tsx",
      "kit": [
        "Avatar",
        "AvatarFallback",
        "AvatarBadge"
      ],
      "note": "Fallback tone is a hash of the name, so one person keeps one circle everywhere. The badge carries presence; the tone never does."
    },
    {
      "part": "identity avatar",
      "module": "src/shared/IdentityAvatar.tsx",
      "kit": [
        "Avatar",
        "AvatarFallback"
      ],
      "note": "PresenceAvatar without the presence badge, reusing the same tone hash and initials from src/shared/format.ts, for an identity that carries no live state of its own - a mail correspondent, not a chat contact."
    },
    {
      "part": "loading and load-error panes",
      "module": "src/shared/QueryStates.tsx",
      "kit": [
        "Skeleton",
        "Alert",
        "AlertTitle",
        "AlertDescription",
        "AlertAction",
        "Button",
        "lucide-react: CircleAlertIcon"
      ],
      "note": "firstPaintOf gates a screen's first paint on every query it needs; LoadingPane shows a Skeleton while any is pending, LoadErrorPane a destructive Alert with a retry when any has failed. Every screen uses both."
    }
  ],
  "screens": [
    {
      "id": "dashboard",
      "panes": [
        {
          "pane": "KPI row",
          "module": "src/screens/dashboard/KpiRow.tsx",
          "note": "Three KpiCard.tsx cards, one inline chart type and one accent hue each (area, bar, line) so the row reads as varied instruments rather than one chart repeated, then ContactsByStageCard.tsx as the row's fourth card - see src/screens/dashboard/dashboardChartConfig.ts for the palette.",
          "parts": [
            {
              "part": "value, delta badge, footer stat",
              "kit": [
                "Card",
                "CardContent",
                "CardFooter",
                "Badge"
              ]
            },
            {
              "part": "inline chart",
              "kit": [
                "ChartContainer",
                "ChartConfig"
              ],
              "module": "src/screens/dashboard/Sparkline.tsx",
              "note": "Recharts primitives composed inside ChartContainer, per the kit chart doc: AreaChart+Area (gradient-filled), BarChart+Bar (rounded corners), LineChart+Line (smooth)."
            },
            {
              "part": "contacts by stage",
              "module": "src/screens/dashboard/ContactsByStageCard.tsx",
              "kit": [
                "Card",
                "CardHeader",
                "CardTitle",
                "CardContent",
                "ChartContainer",
                "ChartTooltip",
                "ChartTooltipContent"
              ],
              "note": "Recharts PieChart+Pie with a Cell per stage, drawn as a thick-ring donut, and a legend list of dot, label, count and percent in plain markup - the kit's ChartLegendContent renders a swatch and a label only."
            }
          ]
        },
        {
          "pane": "resolved per day",
          "module": "src/screens/dashboard/ResolvedPerDayCard.tsx",
          "parts": [
            {
              "part": "large stacked bar chart",
              "kit": [
                "Card",
                "CardHeader",
                "CardTitle",
                "CardContent",
                "ChartContainer",
                "ChartTooltip",
                "ChartTooltipContent",
                "ChartLegend",
                "ChartLegendContent"
              ],
              "note": "Recharts BarChart with one stacked Bar per source (Chat, Mail, Tasks), a CartesianGrid and both axes; the tooltip shows every segment's value and the legend names the sources."
            }
          ]
        },
        {
          "pane": "new contacts",
          "module": "src/screens/dashboard/NewContactsCard.tsx",
          "parts": [
            {
              "part": "hero number and breakdown",
              "kit": [
                "Card",
                "CardHeader",
                "CardTitle",
                "CardContent",
                "Badge"
              ]
            },
            {
              "part": "combo chart",
              "kit": [
                "ChartContainer",
                "ChartTooltip",
                "ChartTooltipContent"
              ],
              "note": "Recharts ComposedChart: a low-opacity Bar for the daily inbound volume with a bold Line for the combined total riding over it - the line is the hero, the bars are its context."
            }
          ]
        },
        {
          "pane": "summary",
          "module": "src/screens/dashboard/SummaryCard.tsx",
          "parts": [
            {
              "part": "icon-stat cells",
              "kit": [
                "Card",
                "CardHeader",
                "CardTitle",
                "CardContent",
                "lucide-react: MessageSquareIcon, ClockIcon, CircleAlertIcon"
              ],
              "note": "Open/Pending/Escalated counts are computed from the same activity collection the recent-activity table renders, never a separately-stored total."
            },
            {
              "part": "trend area",
              "kit": [
                "ChartContainer"
              ],
              "note": "A small gradient-filled Recharts AreaChart, distinct in shape from row 2's other two charts."
            },
            {
              "part": "disabled CTA",
              "kit": [
                "Card",
                "CardFooter",
                "Button"
              ],
              "note": "\"View report\", rendered disabled - this template ships no report screen behind it, the same convention as the chat thread's create-ticket button."
            }
          ]
        },
        {
          "pane": "records created",
          "module": "src/screens/dashboard/RecordsCreatedCard.tsx",
          "parts": [
            {
              "part": "total and twelve-month line chart",
              "kit": [
                "Card",
                "CardHeader",
                "CardTitle",
                "CardAction",
                "CardContent",
                "ChartContainer",
                "ChartTooltip",
                "ChartTooltipContent",
                "ChartLegend",
                "ChartLegendContent"
              ],
              "note": "Recharts LineChart with three Lines (companies, opportunities, people) over the last twelve calendar months; the Y axis starts at zero and grows with the data."
            },
            {
              "part": "period select",
              "kit": [
                "Select",
                "SelectTrigger",
                "SelectValue",
                "SelectContent",
                "SelectItem"
              ],
              "note": "Rendered disabled: the template ships one fixed twelve-month window."
            }
          ]
        },
        {
          "pane": "top agents",
          "module": "src/screens/dashboard/TopAgentsCard.tsx",
          "parts": [
            {
              "part": "ranked list",
              "kit": [
                "Card",
                "CardHeader",
                "CardTitle",
                "CardContent",
                "Avatar",
                "AvatarFallback",
                "Badge"
              ],
              "note": "Ranked by resolved-count, an Avatar plus a Badge trailing each row."
            }
          ]
        },
        {
          "pane": "team workload",
          "module": "src/screens/dashboard/WorkloadStrip.tsx",
          "parts": [
            {
              "part": "icon + value + progress strip",
              "kit": [
                "Card",
                "CardHeader",
                "CardTitle",
                "CardContent",
                "Progress",
                "lucide-react: HeadsetIcon, CodeIcon, FolderKanbanIcon, ClipboardCheckIcon"
              ],
              "note": "Four workload metrics (support, development, CRM and QA) side by side, each an icon chip plus a value/max readout plus a Progress bar."
            }
          ]
        },
        {
          "pane": "stage funnel",
          "module": "src/screens/dashboard/StageFunnelCard.tsx",
          "parts": [
            {
              "part": "funnel",
              "kit": [
                "Card",
                "CardHeader",
                "CardTitle",
                "CardContent"
              ],
              "note": "A plain SVG of equal-height trapezoid bands, each edge its stage's share of the widest stage, scaled uniformly (preserveAspectRatio xMidYMid meet); funnelSegmentGeometry in dashboardSelectors.ts fits each label to its segment and drops one that cannot fit."
            }
          ]
        },
        {
          "pane": "conversion by source",
          "module": "src/screens/dashboard/ConversionBySourceCard.tsx",
          "parts": [
            {
              "part": "stacked horizontal bars",
              "kit": [
