{
  "name": "@gears-frontx/frontx-template-calendar",
  "version": "0.1.0-alpha.0",
  "description": "FrontX calendar feature template: the @gears-frontx/calendar-kit package and its workspace toolchain.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "type-check": "npm run type-check --workspaces && npm run type-check:demo --workspace=@gears-frontx/calendar-kit",
    "arch:deps": "npx dependency-cruiser packages/ --config .dependency-cruiser.cjs --output-type err-long",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "npm run test:unit --workspaces",
    "test:dist": "npm run test:dist --workspace=@gears-frontx/calendar-kit",
    "test:consumer": "npm run test:consumer --workspace=@gears-frontx/calendar-kit",
    "demo": "npm run demo --workspace=@gears-frontx/calendar-kit"
  },
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "dependency-cruiser": "17.3.10",
    "eslint": "9.27.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "15.12.0",
    "typescript-eslint": "8.65.0"
  }
}
